# Export these in your shell before running the app, or put the same keys in
# .streamlit/secrets.toml (see secrets.toml.example). The app reads environment
# variables and Streamlit secrets; it does not load a .env file by itself.
# Never commit real values.
FALLGUARD_TELEGRAM_TOKEN=123456789:replace-with-your-bot-token
FALLGUARD_TELEGRAM_CHAT_ID=replace-with-your-chat-id
