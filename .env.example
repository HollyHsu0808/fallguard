# Copy to app/.env (git-ignored). The app pre-fills the sidebar from these.
# Production URL of the Webhook node in n8n/FallGuard Flow 3.json
N8N_WEBHOOK_URL=https://<your-subdomain>.app.n8n.cloud/webhook/fallguard
# Same value as the Header Auth credential (name X-FallGuard-Key) on that Webhook node
N8N_WEBHOOK_KEY=
