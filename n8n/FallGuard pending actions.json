      "name": "Pick resident",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        520,
        200
      ],
      "parameters": {
        "jsCode": "// Match the camera / file name to a residents row; fall back to the row named\n// 'default', then to the first row, so a demo video never gets lost because\n// its file name is missing from the sheet. profile_match says which one hit.\nconst src = String($('Profile webhook').first().json.query.source || '').trim().toLowerCase();\nconst rows = $input.all().map(i => i.json);\nconst norm = v => String(v || '').trim().toLowerCase();\nconst row = rows.find(r => norm(r.source_name) === src)\n         || rows.find(r => norm(r.source_name) === 'default')\n         || rows[0];\nif (!row) return [{ json: { error: 'residents sheet is empty' } }];\nreturn [{ json: { ...row, profile_match: norm(row.source_name) === src ? 'exact' : 'fallback' } }];\n"
      }
    }
